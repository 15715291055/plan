# Frontend-safe Supabase values (the anon key is protected by RLS policies)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side model defaults.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Vercel server variables. Do not expose these with a VITE_ prefix.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# DEEPSEEK_KEY_ENCRYPTION_KEY=64-character random hexadecimal key
