# Frontend-safe Supabase values (the anon key is protected by RLS policies)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional server-side defaults. A user's DeepSeek key is entered in Settings
# and is sent only for that request; it is never read from this file.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
